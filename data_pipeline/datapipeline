print("\nQUERY 6")
print("Books with Category")

join_query = """

SELECT

b.title,

c.category_name,

b.rating,

b.price_inr

FROM books b

JOIN categories c

ON b.category_id=c.category_id

ORDER BY b.rating DESC

LIMIT 10

"""

join_df = pd.read_sql(join_query, conn)

