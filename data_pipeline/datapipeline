import requests
import pandas as pd
from bs4 import BeautifulSoup
from urllib.parse import urljoin
import os
import sqlite3
import pandas as pd

BASE_URL = "https://books.toscrape.com/catalogue/page-{}.html"
GBP_TO_INR = 105.50
RATING_MAP = {
    "One": 1,
    "Two": 2,
    "Three": 3,
    "Four": 4,
    "Five": 5
}

os.makedirs("output", exist_ok=True)

books_data = []

print("=" * 60)
print("STARTING SCRAPING...")
print("=" * 60)

for page in range(1, 6):

    print(f"\nScraping Page {page}...")

    url = BASE_URL.format(page)

    response = requests.get(url)

    if response.status_code != 200:
        print(f"Failed to load Page {page}")
        continue

    soup = BeautifulSoup(response.text, "html.parser")

    books = soup.find_all("article", class_="product_pod")

    print(f"Books Found : {len(books)}")
    for book in books:
        title = book.h3.a["title"]
        price_text = book.find("p", class_="price_color").text.strip()
        rating_text = book.find("p")["class"][1]
        availability_text = (
            book.find("p", class_="instock availability")
            .text.strip()
        )
    
        relative_link = book.h3.a["href"]
        detail_url = urljoin(url, relative_link)
        detail_response = requests.get(detail_url)
        if detail_response.status_code == 200:
            detail_soup = BeautifulSoup(
                detail_response.text,
                "html.parser"
            )
            breadcrumb = detail_soup.select("ul.breadcrumb li a")

            if len(breadcrumb) >= 3:
                category = breadcrumb[2].text.strip()
            else:
                category = "Unknown"

        else:
            category = "Unknown"

        
        try:
            price_gbp = float(
                price_text.replace("£", "").replace("Â", "")
            )
        except:
            price_gbp = None

        
        rating = RATING_MAP.get(rating_text)

        
        in_stock = "In stock" in availability_text

        
        if price_gbp is not None:
            price_inr = round(price_gbp * GBP_TO_INR, 2)
        else:
            price_inr = None

        books_data.append({

            "title": title,

            "price_gbp": price_gbp,

            "price_inr": price_inr,

            "rating": rating,

            "in_stock": in_stock,

            "category": category

        })

df = pd.DataFrame(books_data)

print("\nTotal Books Scraped :", len(df))

print("\nChecking Missing Values...")

print(df.isnull().sum())


df["price_gbp"] = df["price_gbp"].fillna(
    df["price_gbp"].median()
)

df["price_inr"] = df["price_inr"].fillna(
    df["price_inr"].median()
)

df["rating"] = df["rating"].fillna(
    int(df["rating"].median())
)

df["price_gbp"] = df["price_gbp"].astype(float)

df["price_inr"] = df["price_inr"].astype(float)

df["rating"] = df["rating"].astype(int)

df["in_stock"] = df["in_stock"].astype(bool)


csv_path = "output/books.csv"

df.to_csv(csv_path, index=False)

print("\nCSV Saved Successfully!")

print(csv_path)


